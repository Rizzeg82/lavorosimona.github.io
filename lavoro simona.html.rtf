function build()\{const q=S.q,B=q.who;const opt=(lo,hi,d,z)=>\{let o='';for(let x=lo;x<=hi;x++)if(!(z&&x==0))o+=`<option value="$\{x\}"$\{x==d?' selected':''\}>$\{f(x)\}</option>`;return o\};\
const sg=(id,l,d)=>`<select id="$\{id\}">$\{l.map(x=>`<option$\{x==d?' selected':''\}>$\{x\}</option>`).join('')\}</select>`;\
const rw=n=>`<div class="cmp"><select id="k$\{n\}">$\{opt(-5,5,n==1?-1:1,1)\}</select> \'b7 x + <select id="m$\{n\}">$\{opt(-9,9,0)\}</select> $\{sg('o'+n,['<','\uc0\u8804 ','>','\u8805 '],n==1?'>':'<')\} <select id="n$\{n\}">$\{opt(-60,60,0)\}</select></div>`;\
$('#bd').innerHTML=`<p>
\f4 \uc0\u55358 \u56809 
\f3  <b>Giocatore $\{B\}</b> costruisce la trappola. <b>Giocatore $\{3-B\}</b>: non guardare lo schermo!</p><p><b>1) Scegli la soluzione</b> (un intervallo oppure una semiretta)</p><div class="mode"><button class="btn on" data-m="seg">Tra due numeri</button> <button class="btn" data-m="ray">Semiretta</button></div><div class="cmp" id="tg"></div><p><b>2) Inventa due disequazioni</b> (almeno una con un numero negativo davanti a x)</p>$\{rw(1)\}$\{rw(2)\}<div id="lv"></div><button class="btn" id="idea">
\f4 \uc0\u55357 \u56481 
