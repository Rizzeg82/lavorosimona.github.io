let md='seg';const g=i=>$('#'+i).value,T=()=>md=='seg'?\{a:+g('a'),ai:g('s1')=='\uc0\u8804 ',b:+g('b'),bi:g('s2')=='\u8804 '\}:from(g('s'),+g('a')),CC=n=>raw(+g('k'+n),+g('m'+n),g('o'+n),+g('n'+n));\
const up=()=>\{const t=T(),c1=CC(1),c2=CC(2),I=inter(c1.iv,c2.iv),same=!emp(t)&&eq(I,t),neg=c1.k<0||c2.k<0;\
$('#lv').innerHTML=nl([\{v:t,c:C1,label:'Soluzione scelta'\},\{v:I,c:C2,label:'Soluzione del tuo sistema'\}])+`<p>$\{same?'
