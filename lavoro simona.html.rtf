$('#okb').disabled=!(same&&neg);q.c=[c1,c2,t]\};\
document.querySelectorAll('#bd select').forEach(e=>e.onchange=up);\
const tgH=m=>m=='seg'?`<select id="a">$\{opt(-10,10,1)\}</select>$\{sg('s1',['<','\uc0\u8804 '],'<')\}<b>x</b>$\{sg('s2',['<','\u8804 '],'<')\}<select id="b">$\{opt(-10,10,5)\}</select>`:`<b>x</b>$\{sg('s',['<','\u8804 ','>','\u8805 '],'>')\}<select id="a">$\{opt(-10,10,2)\}</select>`;\
const setM=m=>\{md=m;document.querySelectorAll('#bd .mode .btn').forEach(x=>x.classList.toggle('on',x.dataset.m==m));$('#tg').innerHTML=tgH(m);document.querySelectorAll('#tg select').forEach(e=>e.onchange=up);up()\};\
document.querySelectorAll('#bd .mode .btn').forEach(x=>x.onclick=()=>setM(x.dataset.m));\
$('#idea').onclick=()=>\{const t=T();if(emp(t))return;let c1,c2;if(t.a==-INF)\{c1=cons('hi',t.b,t.bi,1);c2=cons('hi',t.b+3,1,0)\}else if(t.b==INF)\{c1=cons('lo',t.a,t.ai,1);c2=cons('lo',t.a-3,1,0)\}else\{c1=cons('lo',t.a,t.ai,1);c2=cons('hi',t.b,t.bi,0)\}[[1,c1],[2,c2]].forEach(([n,c])=>\{$('#k'+n).value=c.k;$('#m'+n).value=c.m;$('#o'+n).value=c.op;$('#n'+n).value=c.n\});up()\};\
